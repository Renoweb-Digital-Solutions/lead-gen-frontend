{
  "html": "<!doctype html>\n<html lang=\"en\">\n<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><meta name=\"color-scheme\" content=\"light\"><title>A personal note</title></head>\n<body style=\"margin:0;padding:0;background:#eef3fb;color:#23324a;\">\n<!-- # Email-safe layout uses presentation tables and inline styles, with no\n     # external assets, scripts, tracking pixels, or invented performance claims. -->\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#eef3fb;\"><tr><td align=\"center\" style=\"padding:36px 16px;\">\n<table role=\"presentation\" width=\"620\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;max-width:620px;\">\n<tr><td style=\"padding:0 8px 18px;font:12px Arial,sans-serif;color:#77859e;\">A personal note from {{sender_name}}</td></tr>\n<tr><td style=\"height:4px;background:#2468ee;font-size:0;line-height:0;border-radius:16px 16px 0 0;\">&nbsp;</td></tr>\n<tr><td style=\"padding:26px 34px;background:#ffffff;border-left:1px solid #e0e8f5;border-right:1px solid #e0e8f5;\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"font:bold 19px Arial,sans-serif;letter-spacing:-.7px;color:#1754d1;\">SIMPLE<span style=\"color:#3997ee;\">ADS</span></td><td align=\"right\" style=\"font:10px Arial,sans-serif;letter-spacing:1.8px;color:#7c8da8;\">PERSONAL OUTREACH</td></tr></table>\n</td></tr>\n<tr><td style=\"padding:32px 34px;background:#102750;color:#ffffff;border-left:1px solid #102750;border-right:1px solid #102750;\">\n<p style=\"margin:0 0 14px;font:bold 10px Arial,sans-serif;letter-spacing:2.5px;color:#8bc8ff;\">A NEW CONVERSATION</p>\n<h1 style=\"margin:0;font:normal 34px/1.18 Georgia,serif;letter-spacing:-.7px;color:#ffffff;\">A small introduction.<br>A worthwhile connection.</h1>\n<p style=\"margin:16px 0 0;font:13px/1.7 Arial,sans-serif;color:#c1d3ec;\">One person. One thoughtful note. A chance to connect.</p>\n</td></tr>\n<tr><td style=\"padding:32px 34px 26px;background:#ffffff;border-left:1px solid #e0e8f5;border-right:1px solid #e0e8f5;font:14px/1.85 Arial,sans-serif;color:#23324a;\">{{content}}</td></tr>\n<tr><td style=\"padding:0 34px 30px;background:#ffffff;border:1px solid #e0e8f5;border-top:0;border-radius:0 0 16px 16px;\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"padding-top:20px;border-top:1px solid #e8edf5;\">\n<p style=\"margin:0;font:bold 12px/1.7 Arial,sans-serif;color:#263d60;\">Reply when it works for you.</p>\n<p style=\"margin:4px 0 0;font:12px/1.8 Arial,sans-serif;color:#8190a6;\">This message was sent by {{sender_name}}<br>{{sender_email}}</p>\n</td></tr></table></td></tr>\n<tr><td align=\"center\" style=\"padding:20px 20px 8px;font:11px/1.9 Arial,sans-serif;color:#8190a6;\">Prefer not to receive another note?<br><a href=\"{{unsubscribe_url}}\" style=\"color:#697c98;text-decoration:underline;\">Unsubscribe from this sender</a></td></tr>\n</table></td></tr></table>\n</body></html>\n",
  "tagStyles": {
    "p": "margin:0 0 18px;font:14px/1.85 Arial,sans-serif;color:#23324a;",
    "h2": "margin:0 0 18px;font:normal 25px/1.35 Georgia,serif;color:#173d73;",
    "h3": "margin:0 0 14px;font:bold 17px/1.5 Arial,sans-serif;color:#173d73;",
    "blockquote": "margin:24px 0;padding:17px 20px;border-left:3px solid #308fef;background:#f2f7ff;font:14px/1.85 Arial,sans-serif;color:#284c7d;",
    "ul": "margin:14px 0 22px;padding-left:22px;line-height:1.85;",
    "ol": "margin:14px 0 22px;padding-left:22px;line-height:1.85;",
    "li": "margin:0 0 8px;",
    "a": "color:#175ee7;text-decoration:underline;"
  }
}
